SECRET_KEY=your_secret_key_here  # python -c "import secrets; print(secrets.token_hex(32))"
DATABASE_URL=sqlite:///./tradepath.db
ALLOWED_ORIGINS=["http://localhost:5173","http://localhost:3000"]
RATE_LIMIT_PER_MINUTE=60
ACCESS_TOKEN_EXPIRE_MINUTES=30
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4.1-mini

# Azure Document Intelligence (required for trade document OCR)
AZURE_DI_ENDPOINT=https://your-resource.cognitiveservices.azure.com/
AZURE_DI_KEY=your_azure_document_intelligence_key_here

# Azure Storage (optional — for document uploads)
AZURE_STORAGE_CONNECTION_STRING=your_azure_storage_connection_string_here
AZURE_STORAGE_CONTAINER=trade-docs

# Redis / Celery (optional — for async tasks)
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# SDN sanctions list refresh interval (hours)
SDN_REFRESH_HOURS=4
